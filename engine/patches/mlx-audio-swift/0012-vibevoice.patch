new file mode 100644
index 0000000..2495e81
--- /dev/null
+++ b/Sources/MLXAudioTTS/Models/VibeVoice/VibeVoiceAcoustic.swift
@@ -0,0 +1,221 @@
+// Copyright (c) 2025, Prince Canuma and contributors (https://github.com/Blaizzy/mlx-audio)
+import Foundation
+import MLX
+import MLXNN
+
+/// One invocation owns one cache. All tensors use (batch, time, channels).
+final class VibeVoiceConvolutionCache {
+    var state: [ObjectIdentifier: MLXArray] = [:]
+    func evaluate() { eval(Array(state.values)) }
+}
+final class VibeVoiceSynthesisConv: Module {
+    let conv: Conv1d
+    let padding: Int
+    let stride: Int
+    let inputChannels: Int
+    let depthwise: Bool
+    init(_ input: Int, _ output: Int, kernel: Int, stride: Int = 1, depthwise: Bool = false, bias: Bool = true) {
+        padding = kernel - stride
+        self.stride = stride
+        inputChannels = input
+        self.depthwise = depthwise
+        conv = Conv1d(inputChannels: input, outputChannels: output, kernelSize: kernel, stride: stride, groups: depthwise ? input : 1, bias: bias)
+    }
+    func callAsFunction(_ input: MLXArray, cache: VibeVoiceConvolutionCache? = nil) -> MLXArray {
+        var x: MLXArray
+        if let cache {
+            precondition(input.dim(1) % stride == 0, "Streaming convolution chunks must align with stride")
+            let left = cache.state[ObjectIdentifier(self)] ?? .zeros([input.dim(0), padding, inputChannels], dtype: input.dtype)
+            x = concatenated([left, input], axis: 1)
+            if padding > 0 { cache.state[ObjectIdentifier(self)] = x[0..., (x.dim(1) - padding)..., 0...] }
+        } else {
+            let extra = (stride - input.dim(1) % stride) % stride
+            x = padded(input, widths: [.init((0, 0)), .init((padding, extra)), .init((0, 0))])
+        }
+        if !depthwise { return conv(x) }
+        let kernel = conv.weight.dim(1)
+        let count = (x.dim(1) - kernel) / stride + 1
+        // Grouped convolution accumulates products in Float32, then casts before bias.
+        // Preserve the original input tensors in the streaming cache.
+        let outputDType = x.dtype == conv.weight.dtype ? x.dtype : .float32
+        let full = x.asType(.float32), weight = conv.weight.asType(.float32)
+        var y = full[0..., .stride(from: 0, to: count * stride, by: stride), 0...] * weight[0..., 0, 0]
+        for k in 1..<kernel {
+            y = y + full[0..., .stride(from: k, to: k + count * stride, by: stride), 0...] * weight[0..., k, 0]
+        }
+        y = y.asType(outputDType)
+        if let bias = conv.bias { y = y + bias }
+        return y
+    }
+}
+final class VibeVoiceSynthesisTransposeConv: Module {
+    let convtr: ConvTransposed1d
+    let stride: Int
+    let padding: Int
+    init(_ input: Int, _ output: Int, ratio: Int, bias: Bool) {
+        stride = ratio
+        padding = ratio
+        convtr = ConvTransposed1d(inputChannels: input, outputChannels: output, kernelSize: ratio * 2, stride: ratio, bias: bias)
+    }
+    func callAsFunction(_ x: MLXArray, cache: VibeVoiceConvolutionCache? = nil) -> MLXArray {
+        guard let cache else {
+            let y = convtr(x)
+            return y[0..., ..<(y.dim(1) - padding), 0...]
+        }
+        // Sum overlap before adding bias, so each emitted sample receives bias once.
+        var y = convTransposed1d(x, convtr.weight, stride: stride)
+        if let pending = cache.state[ObjectIdentifier(self)], pending.dim(1) > 0 {
+            let overlap = min(pending.dim(1), y.dim(1))
+            y = concatenated([y[0..., ..<overlap, 0...] + pending[0..., ..<overlap, 0...], y[0..., overlap..., 0...]], axis: 1)
+        }
+        let count = x.dim(1) * stride
+        cache.state[ObjectIdentifier(self)] = y[0..., count..., 0...]
+        let output = y[0..., ..<count, 0...]
+        return convtr.bias.map { output + $0 } ?? output
+    }
+}
+final class VibeVoiceSynthesisFFN: Module {
+    @ModuleInfo var linear1: Linear
+    @ModuleInfo var linear2: Linear
+    init(_ dim: Int, bias: Bool) {
+        _linear1.wrappedValue = Linear(dim, dim * 4, bias: bias)
+        _linear2.wrappedValue = Linear(dim * 4, dim, bias: bias)
+    }
+    func callAsFunction(_ x: MLXArray) -> MLXArray { linear2(gelu(linear1(x))) }
+}
+final class VibeVoiceSynthesisBlock: Module {
+    let norm: RMSNorm
+    @ModuleInfo(key: "ffn_norm") var ffnNorm: RMSNorm
+    let mixer: VibeVoiceSynthesisConv
+    let ffn: VibeVoiceSynthesisFFN
+    @ParameterInfo var gamma: MLXArray?
+    @ParameterInfo(key: "ffn_gamma") var ffnGamma: MLXArray?
+    init(_ dim: Int, _ c: VibeVoiceAcousticConfig) {
+        norm = RMSNorm(dimensions: dim, eps: c.layernormEps)
+        _ffnNorm.wrappedValue = RMSNorm(dimensions: dim, eps: c.layernormEps)
+        mixer = VibeVoiceSynthesisConv(dim, dim, kernel: 7, depthwise: true, bias: c.convBias)
+        ffn = VibeVoiceSynthesisFFN(dim, bias: c.convBias)
+        if c.layerScaleInitValue > 0 {
+            _gamma.wrappedValue = .ones([dim]) * c.layerScaleInitValue
+            _ffnGamma.wrappedValue = .ones([dim]) * c.layerScaleInitValue
+        }
+    }
+    func callAsFunction(_ input: MLXArray, cache: VibeVoiceConvolutionCache? = nil) -> MLXArray {
+        var h = mixer(norm(input), cache: cache)
+        if let gamma { h = h * gamma }
+        h = input + h
+        var y = ffn(ffnNorm(h))
+        if let ffnGamma { y = y * ffnGamma }
+        return h + y
+    }
+}
+final class VibeVoiceSynthesisStage: Module {
+    let blocks: [VibeVoiceSynthesisBlock]
+    init(_ depth: Int, dimension: Int, config: VibeVoiceAcousticConfig) {
+        blocks = (0..<depth).map { _ in VibeVoiceSynthesisBlock(dimension, config) }
+    }
+}
+final class VibeVoiceSynthesisEncoder: Module {
+    @ModuleInfo(key: "downsample_layers") var downsampleLayers: [VibeVoiceSynthesisConv]
+    let stages: [VibeVoiceSynthesisStage]
+    let norm: RMSNorm?
+    let head: VibeVoiceSynthesisConv
+    init(_ c: VibeVoiceAcousticConfig) {
+        var layers = [VibeVoiceSynthesisConv(c.channels, c.encoderNFilters, kernel: 7, bias: c.convBias)]
+        let ratios = Array(c.encoderRatios.reversed())
+        var dim = c.encoderNFilters
+        var stages: [VibeVoiceSynthesisStage] = []
+        for i in c.encoderDepths.indices {
+            if i > 0 {
+                layers.append(VibeVoiceSynthesisConv(dim, dim * 2, kernel: ratios[i - 1] * 2, stride: ratios[i - 1], bias: c.convBias))
+                dim *= 2
+            }
+            stages.append(VibeVoiceSynthesisStage(c.encoderDepths[i], dimension: dim, config: c))
+        }
+        _downsampleLayers.wrappedValue = layers
+        self.stages = stages
+        norm = c.disableLastNorm ? nil : RMSNorm(dimensions: dim, eps: c.layernormEps)
+        head = VibeVoiceSynthesisConv(dim, c.vaeDim, kernel: 7, bias: c.convBias)
+    }
+    func callAsFunction(_ audio: MLXArray, cache: VibeVoiceConvolutionCache? = nil) -> MLXArray {
+        var x = audio.ndim == 2 ? audio.expandedDimensions(axis: -1) : audio
+        for i in stages.indices {
+            x = downsampleLayers[i](x, cache: cache)
+            for block in stages[i].blocks { x = block(x, cache: cache) }
+            eval(x)
+        }
+        return head(norm?(x) ?? x, cache: cache)
+    }
+}
+final class VibeVoiceSynthesisUpsample: Module {
+    let conv: VibeVoiceSynthesisConv?
+    let convtr: VibeVoiceSynthesisTransposeConv?
+    init(_ input: Int, _ output: Int, ratio: Int?, bias: Bool) {
+        if let ratio {
+            conv = nil
+            convtr = VibeVoiceSynthesisTransposeConv(input, output, ratio: ratio, bias: bias)
+        } else {
+            conv = VibeVoiceSynthesisConv(input, output, kernel: 7, bias: bias)
+            convtr = nil
+        }
+    }
+    func callAsFunction(_ x: MLXArray, cache: VibeVoiceConvolutionCache?) -> MLXArray {
+        if let conv { return conv(x, cache: cache) }
+        return convtr!(x, cache: cache)
+    }
+}
+final class VibeVoiceSynthesisDecoder: Module {
+    @ModuleInfo(key: "upsample_layers") var upsampleLayers: [VibeVoiceSynthesisUpsample]
+    let stages: [VibeVoiceSynthesisStage]
+    let head: VibeVoiceSynthesisConv
+    init(_ c: VibeVoiceAcousticConfig) {
+        let ratios = c.decoderRatios ?? c.encoderRatios
+        let depths = c.decoderDepths ?? Array(c.encoderDepths.reversed())
+        let filters = c.decoderNFilters
+        var dim = filters * (1 << (depths.count - 1))
+        var layers = [VibeVoiceSynthesisUpsample(c.vaeDim, dim, ratio: nil, bias: c.convBias)]
+        var stages: [VibeVoiceSynthesisStage] = []
+        for i in depths.indices {
+            stages.append(VibeVoiceSynthesisStage(depths[i], dimension: dim, config: c))
+            if i < ratios.count {
+                let next = i < ratios.count - 1 ? dim / 2 : filters
+                layers.append(VibeVoiceSynthesisUpsample(dim, next, ratio: ratios[i], bias: c.convBias))
+                dim = next
+            }
+        }
+        _upsampleLayers.wrappedValue = layers
+        self.stages = stages
+        head = VibeVoiceSynthesisConv(filters, c.channels, kernel: 7, bias: c.convBias)
+    }
+    func callAsFunction(_ latents: MLXArray, cache: VibeVoiceConvolutionCache? = nil) -> MLXArray {
+        var x = upsampleLayers[0](latents, cache: cache)
+        for i in stages.indices {
+            for block in stages[i].blocks { x = block(x, cache: cache) }
+            if i + 1 < upsampleLayers.count { x = upsampleLayers[i + 1](x, cache: cache) }
+            eval(x)
+        }
+        return head(x, cache: cache)
+    }
+}
+final class VibeVoiceAcousticTokenizer: Module {
+    let encoder: VibeVoiceSynthesisEncoder?
+    let decoder: VibeVoiceSynthesisDecoder
+    init(_ config: VibeVoiceAcousticConfig, includeEncoder: Bool = false) {
+        encoder = includeEncoder ? VibeVoiceSynthesisEncoder(config) : nil
+        decoder = VibeVoiceSynthesisDecoder(config)
+    }
+    /// Returns (batch, samples, channels). Latents are always (batch, frames, dimension).
+    func decode(_ latents: MLXArray, cache: VibeVoiceConvolutionCache? = nil) -> MLXArray { decoder(latents, cache: cache) }
+}
+func canonicalVibeVoiceSynthesisPath(_ key: String) -> String {
+    var key = key.hasPrefix("model.") ? String(key.dropFirst(6)) : key
+    key = key.replacingOccurrences(of: #"\.(upsample_layers|downsample_layers)\.(\d+)\.0\."#, with: ".$1.$2.", options: .regularExpression)
+    key = key.replacingOccurrences(of: #"\.downsample_layers\.(\d+)\.conv\.conv\."#, with: ".downsample_layers.$1.conv.", options: .regularExpression)
+    key = key.replacingOccurrences(of: #"\.stages\.(\d+)\.(\d+)\."#, with: ".stages.$1.blocks.$2.", options: .regularExpression)
+    key = key.replacingOccurrences(of: ".head.conv.conv.", with: ".head.conv.")
+    key = key.replacingOccurrences(of: ".mixer.conv.conv.conv.", with: ".mixer.conv.")
+    key = key.replacingOccurrences(of: #"\.t_embedder\.mlp\.(?:layers\.)?0(?=\.|$)"#, with: ".t_embedder.mlp.fc1", options: .regularExpression)
+    key = key.replacingOccurrences(of: #"\.t_embedder\.mlp\.(?:layers\.)?2(?=\.|$)"#, with: ".t_embedder.mlp.fc2", options: .regularExpression)
+    key = key.replacingOccurrences(of: #"\.adaLN_modulation\.(?:layers\.)?1(?=\.|$)"#, with: ".adaLN_modulation.linear", options: .regularExpression)
+    return key
+}
diff --git a/Sources/MLXAudioTTS/Models/VibeVoice/VibeVoiceDiffusion.swift b/Sources/MLXAudioTTS/Models/VibeVoice/VibeVoiceDiffusion.swift
new file mode 100644
index 0000000..7a2fb7e
--- /dev/null
+++ b/Sources/MLXAudioTTS/Models/VibeVoice/VibeVoiceDiffusion.swift
@@ -0,0 +1,171 @@
+// Copyright (c) 2025, Prince Canuma and contributors (https://github.com/Blaizzy/mlx-audio)
+import Foundation
+import MLX
+import MLXNN
+
+final class VibeVoiceSpeechConnector: Module {
+    @ModuleInfo var fc1: Linear
+    let norm: RMSNorm
+    @ModuleInfo var fc2: Linear
+    init(input: Int, output: Int, eps: Float = 1e-6) {
+        _fc1.wrappedValue = Linear(input, output)
+        norm = RMSNorm(dimensions: output, eps: eps)
+        _fc2.wrappedValue = Linear(output, output)
+    }
+    func callAsFunction(_ x: MLXArray) -> MLXArray { fc2(norm(fc1(x))) }
+}
+final class VibeVoiceBinaryClassifier: Module {
+    @ModuleInfo var fc1: Linear
+    @ModuleInfo var fc2: Linear
+    init(_ dim: Int) { _fc1.wrappedValue = Linear(dim, dim); _fc2.wrappedValue = Linear(dim, 1) }
+    func callAsFunction(_ x: MLXArray) -> MLXArray { fc2(relu(fc1(x))) }
+}
+final class VibeVoiceTimestepMLP: Module {
+    @ModuleInfo var fc1: Linear
+    @ModuleInfo var fc2: Linear
+    init(_ dim: Int) {
+        _fc1.wrappedValue = Linear(256, dim, bias: false)
+        _fc2.wrappedValue = Linear(dim, dim, bias: false)
+    }
+    func callAsFunction(_ x: MLXArray) -> MLXArray { fc2(silu(fc1(x))) }
+}
+final class VibeVoiceTimestepEmbedder: Module {
+    let mlp: VibeVoiceTimestepMLP
+    init(_ dim: Int) { mlp = VibeVoiceTimestepMLP(dim) }
+    func callAsFunction(_ t: MLXArray) -> MLXArray {
+        let frequencies = exp(MLXArray(0..<128).asType(.float32) * (-log(Float(10000)) / 128))
+        let angles = t.asType(.float32).expandedDimensions(axis: -1) * frequencies
+        return mlp(concatenated([cos(angles), sin(angles)], axis: -1).asType(t.dtype))
+    }
+}
+final class VibeVoiceDiffusionFFN: Module {
+    @ModuleInfo(key: "gate_proj") var gate: Linear
+    @ModuleInfo(key: "up_proj") var up: Linear
+    @ModuleInfo(key: "down_proj") var down: Linear
+    init(_ dim: Int, _ hidden: Int) {
+        _gate.wrappedValue = Linear(dim, hidden, bias: false)
+        _up.wrappedValue = Linear(dim, hidden, bias: false)
+        _down.wrappedValue = Linear(hidden, dim, bias: false)
+    }
+    func callAsFunction(_ x: MLXArray) -> MLXArray { down(silu(gate(x)) * up(x)) }
+}
+final class VibeVoiceAdaLN: Module {
+    @ModuleInfo var linear: Linear
+    init(_ dim: Int, multiplier: Int) { _linear.wrappedValue = Linear(dim, dim * multiplier, bias: false) }
+    func callAsFunction(_ x: MLXArray) -> MLXArray { linear(silu(x)) }
+}
+final class VibeVoiceDiffusionLayer: Module {
+    let norm: RMSNorm
+    let ffn: VibeVoiceDiffusionFFN
+    @ModuleInfo(key: "adaLN_modulation") var modulation: VibeVoiceAdaLN
+    init(_ c: VibeVoiceDiffusionConfig) {
+        norm = RMSNorm(dimensions: c.hiddenSize, eps: c.rmsNormEps)
+        ffn = VibeVoiceDiffusionFFN(c.hiddenSize, Int(Float(c.hiddenSize) * c.headFFNRatio))
+        _modulation.wrappedValue = VibeVoiceAdaLN(c.hiddenSize, multiplier: 3)
+    }
+    func callAsFunction(_ x: MLXArray, condition: MLXArray) -> MLXArray {
+        let parts = split(modulation(condition), parts: 3, axis: -1)
+        return x + parts[2] * ffn(norm(x) * (1 + parts[1]) + parts[0])
+    }
+}
+final class VibeVoiceDiffusionFinal: Module {
+    @ModuleInfo var linear: Linear
+    @ModuleInfo(key: "adaLN_modulation") var modulation: VibeVoiceAdaLN
+    let epsilon: Float
+    init(_ c: VibeVoiceDiffusionConfig) {
+        _linear.wrappedValue = Linear(c.hiddenSize, c.latentSize, bias: false)
+        epsilon = c.rmsNormEps
+        _modulation.wrappedValue = VibeVoiceAdaLN(c.hiddenSize, multiplier: 2)
+    }
+    func callAsFunction(_ x: MLXArray, condition: MLXArray) -> MLXArray {
+        let parts = split(modulation(condition), parts: 2, axis: -1)
+        let full = x.asType(.float32)
+        let norm = (full * rsqrt(mean(full * full, axis: -1, keepDims: true) + epsilon)).asType(x.dtype)
+        return linear(norm * (1 + parts[1]) + parts[0])
+    }
+}
+final class VibeVoiceDiffusionHead: Module {
+    @ModuleInfo(key: "noisy_images_proj") var noisyProjection: Linear
+    @ModuleInfo(key: "cond_proj") var conditionProjection: Linear
+    @ModuleInfo(key: "t_embedder") var timestepEmbedder: VibeVoiceTimestepEmbedder
+    let layers: [VibeVoiceDiffusionLayer]
+    @ModuleInfo(key: "final_layer") var finalLayer: VibeVoiceDiffusionFinal
+    init(_ c: VibeVoiceDiffusionConfig) {
+        _noisyProjection.wrappedValue = Linear(c.latentSize, c.hiddenSize, bias: false)
+        _conditionProjection.wrappedValue = Linear(c.hiddenSize, c.hiddenSize, bias: false)
+        _timestepEmbedder.wrappedValue = VibeVoiceTimestepEmbedder(c.hiddenSize)
+        layers = (0..<c.headLayers).map { _ in VibeVoiceDiffusionLayer(c) }
+        _finalLayer.wrappedValue = VibeVoiceDiffusionFinal(c)
+    }
+    func projectCondition(_ x: MLXArray) -> MLXArray { conditionProjection(x) }
+    func embedTimesteps(_ t: MLXArray) -> MLXArray { timestepEmbedder(t) }
+    func forward(_ noisy: MLXArray, conditionWithTimestep: MLXArray) -> MLXArray {
+        var x = noisyProjection(noisy)
+        for layer in layers { x = layer(x, condition: conditionWithTimestep) }
+        return finalLayer(x, condition: conditionWithTimestep)
+    }
+    func callAsFunction(_ noisy: MLXArray, timesteps: MLXArray, condition: MLXArray) -> MLXArray {
+        forward(noisy, conditionWithTimestep: projectCondition(condition) + embedTimesteps(timesteps))
+    }
+}
+
+/// Deterministic DPM-Solver++ second-order midpoint updates, with a zero final sigma.
+final class VibeVoiceDPMSolver {
+    let trainingAlpha: [Float]
+    let predictionType: String
+    private(set) var timesteps: [Int] = []
+    private(set) var alpha: [Float] = []
+    private(set) var sigma: [Float] = []
+    private(set) var lambda: [Float] = []
+    private var index = 0
+    private var previous: MLXArray?
+    init(trainingSteps: Int = 1000, betaSchedule: String = "cosine", predictionType: String = "v_prediction") {
+        self.predictionType = predictionType
+        var betas: [Float] = []
+        func alphaBar(_ t: Double) -> Double { pow(cos((t + 0.008) / 1.008 * .pi / 2), 2) }
+        for i in 0..<trainingSteps {
+            if betaSchedule == "linear" { betas.append(0.0001 + Float(i) / Float(trainingSteps - 1) * 0.0199) }
+            else { betas.append(Float(min(1 - alphaBar(Double(i + 1) / Double(trainingSteps)) / alphaBar(Double(i) / Double(trainingSteps)), 0.999))) }
+        }
+        // Match the reference's float32 cumulative product before scalar schedule construction.
+        trainingAlpha = sqrt(cumprod(1 - MLXArray(betas))).asArray(Float.self)
+    }
+    func setTimesteps(_ steps: Int) {
+        precondition(steps > 0 && steps <= trainingAlpha.count)
+        timesteps = (0..<steps).map { Int((Double(trainingAlpha.count - 1) * (1 - Double($0) / Double(steps))).rounded(.toNearestOrEven)) }
+        alpha = []; sigma = []; lambda = []
+        for t in timesteps {
+            let a = Double(trainingAlpha[t])
+            let s = sqrt((1 - a * a) / (a * a))
+            let currentAlpha = 1 / sqrt(s * s + 1)
+            let currentSigma = s * currentAlpha
+            alpha.append(Float(currentAlpha)); sigma.append(Float(currentSigma))
+            lambda.append(Float(log(currentAlpha) - log(currentSigma)))
+        }
+        alpha.append(1); sigma.append(0); lambda.append(.infinity)
+        reset()
+    }
+    func reset() { index = 0; previous = nil }
+    func step(_ output: MLXArray, sample: MLXArray) -> MLXArray {
+        let i = index
+        precondition(i < timesteps.count)
+        let x = sample.asType(.float32)
+        let model = output.asType(.float32)
+        let clean: MLXArray
+        switch predictionType {
+        case "epsilon": clean = (x - sigma[i] * model) / alpha[i]
+        case "sample": clean = model
+        default: clean = alpha[i] * x - sigma[i] * model
+        }
+        let h = lambda[i + 1] - lambda[i]
+        let coefficient = -alpha[i + 1] * (Foundation.exp(-h) - 1)
+        var result = (sigma[i + 1] / sigma[i]) * x + coefficient * clean
+        if i > 0, i < timesteps.count - 1, let previous {
+            let ratio = (lambda[i] - lambda[i - 1]) / h
+            if ratio != 0 { result = result + (0.5 * coefficient / ratio) * (clean - previous) }
+        }
+        previous = clean
+        index += 1
+        return result.asType(output.dtype)
+    }
+}
diff --git a/Sources/MLXAudioTTS/Models/VibeVoice/VibeVoiceQwen2.swift b/Sources/MLXAudioTTS/Models/VibeVoice/VibeVoiceQwen2.swift
new file mode 100644
index 0000000..c59a52e
--- /dev/null
+++ b/Sources/MLXAudioTTS/Models/VibeVoice/VibeVoiceQwen2.swift
@@ -0,0 +1,284 @@
+// The Qwen2 backbone of VibeVoice, as upstream mlx-audio-swift has it in
+// MLXAudioCore/LM/Models/Qwen2.swift at fe2c182 (MIT; port of mlx-lm's
+// qwen2.py), renamed for this backport: at AudioSmith's pin the shared
+// Qwen2 is MLXLLM's, without embedding-only input, an optional final norm
+// or projectToVocabulary. Cache, mask and RoPE helpers are MLXLMCommon's.
+import Foundation
+import MLX
+import MLXLMCommon
+import MLXNN
+
+class VibeVoiceQwen2Attention: Module {
+    let args: VibeVoiceQwen2Configuration
+    let scale: Float
+
+    @ModuleInfo(key: "q_proj") var wq: Linear
+    @ModuleInfo(key: "k_proj") var wk: Linear
+    @ModuleInfo(key: "v_proj") var wv: Linear
+    @ModuleInfo(key: "o_proj") var wo: Linear
+
+    let rope: RoPE
+
+    public init(_ args: VibeVoiceQwen2Configuration) {
+        self.args = args
+
+        let dim = args.hiddenSize
+        let heads = args.attentionHeads
+        let kvHeads = args.kvHeads
+
+        let headDim = args.hiddenSize / heads
+        self.scale = pow(Float(headDim), -0.5)
+
+        _wq.wrappedValue = Linear(dim, heads * headDim, bias: true)
+        _wk.wrappedValue = Linear(dim, kvHeads * headDim, bias: true)
+        _wv.wrappedValue = Linear(dim, kvHeads * headDim, bias: true)
+        _wo.wrappedValue = Linear(heads * headDim, dim, bias: false)
+
+        let ropeScale: Float
+        if let ropeScaling = args.ropeScaling, ropeScaling["type"] == .string("linear"),
+            let factor = ropeScaling["factor"]
+        {
+            if let v = factor.asFloat() {
+                ropeScale = 1 / v
+            } else {
+                fatalError("ropeScaling.factor must be a float")
+            }
+        } else {
+            ropeScale = 1
+        }
+
+        self.rope = RoPE(
+            dimensions: headDim, traditional: args.ropeTraditional, base: args.ropeTheta,
+            scale: ropeScale)
+    }
+
+    public func callAsFunction(
+        _ x: MLXArray, mask: MLXFast.ScaledDotProductAttentionMaskMode, cache: KVCache?
+    ) -> MLXArray {
+        let (B, L) = (x.dim(0), x.dim(1))
+
+        var queries = wq(x)
+        var keys = wk(x)
+        var values = wv(x)
+
+        // prepare the queries, keys and values for the attention computation
+        queries = queries.reshaped(B, L, args.attentionHeads, -1).transposed(0, 2, 1, 3)
+        keys = keys.reshaped(B, L, args.kvHeads, -1).transposed(0, 2, 1, 3)
+        values = values.reshaped(B, L, args.kvHeads, -1).transposed(0, 2, 1, 3)
+
+        let offset = cache?.ropeOffset
+        queries = applyRotaryPosition(rope, to: queries, offset: offset)
+        keys = applyRotaryPosition(rope, to: keys, offset: offset)
+
+        let output = attentionWithCacheUpdate(
+            queries: queries,
+            keys: keys,
+            values: values,
+            cache: cache,
+            scale: scale,
+            mask: mask
+        )
+        .transposed(0, 2, 1, 3)
+        .reshaped(B, L, -1)
+
+        return wo(output)
+    }
+}
+
+class VibeVoiceQwen2MLP: Module, UnaryLayer {
+    @ModuleInfo(key: "gate_proj") var gate: Linear
+    @ModuleInfo(key: "down_proj") var down: Linear
+    @ModuleInfo(key: "up_proj") var up: Linear
+
+    public init(dimensions: Int, hiddenDimensions: Int) {
+        _gate.wrappedValue = Linear(dimensions, hiddenDimensions, bias: false)
+        _down.wrappedValue = Linear(hiddenDimensions, dimensions, bias: false)
+        _up.wrappedValue = Linear(dimensions, hiddenDimensions, bias: false)
+    }
+
+    public func callAsFunction(_ x: MLXArray) -> MLXArray {
+        down(silu(gate(x)) * up(x))
+    }
+}
+
+class VibeVoiceQwen2Block: Module {
+    @ModuleInfo(key: "self_attn") var attention: VibeVoiceQwen2Attention
+    let mlp: VibeVoiceQwen2MLP
+
+    @ModuleInfo(key: "input_layernorm") var inputLayerNorm: RMSNorm
+    @ModuleInfo(key: "post_attention_layernorm") var postAttentionLayerNorm: RMSNorm
+
+    public init(_ args: VibeVoiceQwen2Configuration) {
+        _attention.wrappedValue = VibeVoiceQwen2Attention(args)
+        self.mlp = VibeVoiceQwen2MLP(dimensions: args.hiddenSize, hiddenDimensions: args.intermediateSize)
+        _inputLayerNorm.wrappedValue = RMSNorm(
+            dimensions: args.hiddenSize, eps: args.rmsNormEps)
+        _postAttentionLayerNorm.wrappedValue = RMSNorm(
+            dimensions: args.hiddenSize, eps: args.rmsNormEps)
+    }
+
+    public func callAsFunction(
+        _ x: MLXArray, mask: MLXFast.ScaledDotProductAttentionMaskMode, cache: KVCache?
+    ) -> MLXArray {
+        var r = attention(inputLayerNorm(x), mask: mask, cache: cache)
+        let h = x + r
+        r = mlp(postAttentionLayerNorm(h))
+        let out = h + r
+        return out
+    }
+}
+
+public class VibeVoiceQwen2Model: Module {
+    @ModuleInfo(key: "embed_tokens") var embedTokens: Embedding?
+
+    fileprivate let layers: [VibeVoiceQwen2Block]
+    let norm: RMSNorm?
+    private let slidingWindow: Int?
+    private let slidingLayerStart: Int
+
+    public init(
+        _ args: VibeVoiceQwen2Configuration, includeEmbedding: Bool = true, includeNorm: Bool = true,
+        slidingWindow: Int? = nil, slidingLayerStart: Int = 0
+    ) {
+        self.slidingWindow = slidingWindow
+        self.slidingLayerStart = slidingLayerStart
+        precondition(args.vocabularySize > 0)
+
+        if includeEmbedding {
+            _embedTokens.wrappedValue = Embedding(
+                embeddingCount: args.vocabularySize, dimensions: args.hiddenSize)
+        }
+
+        self.layers = (0 ..< args.hiddenLayers)
+            .map { _ in
+                VibeVoiceQwen2Block(args)
+            }
+        self.norm = includeNorm ? RMSNorm(dimensions: args.hiddenSize, eps: args.rmsNormEps) : nil
+    }
+
+    public func callAsFunction(_ inputs: MLXArray, cache: [KVCache]? = nil) -> MLXArray {
+        callAsFunction(inputEmbeddings: embed(inputs), cache: cache)
+    }
+
+    /// Look up tokens when this stack includes an embedding table.
+    public func embed(_ tokens: MLXArray) -> MLXArray {
+        guard let embedTokens else {
+            preconditionFailure("This Qwen2 stack accepts embeddings only")
+        }
+        return embedTokens(tokens)
+    }
+
+    /// Project hidden states with the input embedding table, including quantized embeddings.
+    public func projectToVocabulary(_ hidden: MLXArray) -> MLXArray {
+        guard let embedTokens else {
+            preconditionFailure("This Qwen2 stack has no vocabulary embedding table")
+        }
+        return embedTokens.asLinear(hidden)
+    }
+
+    public func callAsFunction(inputEmbeddings: MLXArray, cache: [KVCache]? = nil) -> MLXArray {
+        callAsFunction(
+            inputEmbeddings: inputEmbeddings, cache: cache,
+            mask: createAttentionMask(h: inputEmbeddings, cache: cache?.first))
+    }
+
+    /// Run an embedded prompt with an explicit attention mask, including full attention.
+    public func callAsFunction(
+        inputEmbeddings: MLXArray, cache: [KVCache]? = nil,
+        mask: MLXFast.ScaledDotProductAttentionMaskMode
+    ) -> MLXArray {
+        var h = inputEmbeddings
+
+        for (i, layer) in layers.enumerated() {
+            let layerMask: MLXFast.ScaledDotProductAttentionMaskMode
+            if let slidingWindow, i >= slidingLayerStart {
+                layerMask = .array(createCausalMask(
+                    n: h.dim(1), offset: cache?[i].offset ?? 0, windowSize: slidingWindow))
+            } else {
+                layerMask = mask
+            }
+            h = layer(h, mask: layerMask, cache: cache?[i])
+        }
+
+        return norm?(h) ?? h
+    }
+}
