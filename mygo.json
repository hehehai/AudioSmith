{
  "name": "AudioSmith",
  "identifier": "dev.hehehai.audiosmith",
  "version": "0.4.0-beta.8",
  "copyright": "Copyright © 2026 hehehai and the AudioSmith contributors. Licensed under the GNU AGPL-3.0.",
  "main": "./app",
  "out": "build",
  "resources": [
    "LICENSE",
    "NOTICE",
    "THIRD-PARTY-NOTICES.txt"
  ],
  "urlSchemes": [
    "audiosmith"
  ],
  "macos": {
    "minimumSystemVersion": "15.0",
    "icon": "assets/AudioSmith.icon",
    "entitlements": "entitlements.plist",
    "infoPlist": {
      "LSApplicationCategoryType": "public.app-category.music",
      "NSMicrophoneUsageDescription": "AudioSmith records your voice for voice cloning, transcription and dictation. Audio stays on this Mac."
    },
    "helperEntitlements": {
      "engine/audiosmith-engine": "engine/Support/engine.entitlements"
    }
  },
  "fileAssociations": [
    {
      "ext": [
        "asvoice"
      ],
      "name": "AudioSmith Voice",
      "mimeType": "application/vnd.audiosmith.voice+zip",
      "role": "Editor"
    },
    {
      "ext": [
        "ovsvoice"
      ],
      "name": "VoiceStudio Voice",
      "role": "Viewer"
    }
  ]
}
