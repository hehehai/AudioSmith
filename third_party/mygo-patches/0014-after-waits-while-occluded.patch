+package ui
+
+import (
+	"github.com/egoist/mygo/internal/platform"
+	"testing"
+	"time"
+)
+
+// After's frames wait while nothing of the window shows, and the view
+// builds at once when some of it shows again; changes of the state still
+// build frames meanwhile.
+func TestAfterWaitsWhileOccluded(t *testing.T) {
+	builds, count := 0, 0
+	tt := coreNewTester(func(c *context) {
+		builds++
+		coreTextf(c, "%d", count)
+		c.After(100 * time.Millisecond)
+	}, 100, 100)
+	builds = 0
+	tt.Advance(time.Second)
+	if builds < 9 || builds > 11 {
+		t.Fatalf("shown: %d builds in a second, want 10", builds)
+	}
+	tt.SetOccluded(true)
+	builds = 0
+	tt.Advance(5 * time.Second)
+	// The timer armed while it showed may still fire once.
+	if builds > 1 {
+		t.Fatalf("hidden: %d builds in 5 s", builds)
+	}
+	if tt.h.afterAt != (time.Time{}) || !tt.rt.afterHeld {
+		t.Fatalf("hidden: timer at %v, held %v", tt.h.afterAt, tt.rt.afterHeld)
+	}
+	count++
+	tt.rt.changed()
+	builds = 0
+	tt.Advance(10 * time.Millisecond)
+	if builds != 1 || !tt.HasText("1") {
+		t.Fatalf("a change while hidden: %d builds, shows %q", builds, tt.Texts())
+	}
+	builds = 0
+	tt.SetOccluded(false)
+	if builds != 1 {
+		t.Fatalf("shown again: %d builds at once, want 1", builds)
+	}
+	builds = 0
+	tt.Advance(time.Second)
+	if builds < 9 || builds > 11 {
+		t.Fatalf("shown again: %d builds in a second, want 10", builds)
+	}
+}
+
+// A window shown again asks for no frame when no After waited.
+func TestShownWithoutAfter(t *testing.T) {
+	tt := coreNewTester(func(c *context) { coreTextf(c, "x") }, 100, 100)
+	tt.h.hidden = true
+	tt.Frame()
+	tt.h.hidden = false
+	tt.h.requested.Store(false)
+	tt.rt.event(platform.SurfaceEvent{Kind: platform.SurfaceShown})
+	if tt.h.requested.Load() || tt.rt.afterHeld {
+		t.Fatal("shown again with nothing waiting, it asked for a frame")
+	}
+}
