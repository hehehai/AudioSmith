+// SetDot shows a dot of a CSS color (see WindowOptions.BackgroundColor's
+// forms) over the icon's top right corner, 5 points across, its centre 3.5
+// points in from the icon's top and right edges; "" removes it. The dot
+// keeps its color over a template icon, which macOS tints to the menu bar,
+// so a template can say "busy" in red: leave a gap in the icon where the
+// dot goes. It places the dot for an icon without a title, and does
+// nothing on other platforms.
+func (t *Tray) SetDot(color string) error {
+	var c platform.Color
+	if color != "" {
+		var err error
+		if c, err = parseColor(color); err != nil {
+			return err
+		}
+	}
+	t.do(func(n platform.Tray) {
+		if d, ok := n.(platform.TrayDot); ok {
+			d.SetDot(c, color != "")
+		}
+	})
+	return nil
+}
+
 // SetTitle sets the text next to the icon (macOS).
 func (t *Tray) SetTitle(title string) { t.do(func(n platform.Tray) { n.SetTitle(title) }) }
 
diff --git a/tray_dot_test.go b/tray_dot_test.go
new file mode 100644
index 0000000..dcfb5e7
--- /dev/null
+++ b/tray_dot_test.go
@@ -0,0 +1,42 @@
+//go:build !js
+
+package mygo
+
+import (
+	"testing"
+
+	"github.com/egoist/mygo/internal/platform"
+)
+
+func TestTrayDot(t *testing.T) {
+	tr, err := NewTray(TrayOptions{Icon: []byte("png"), IconIsTemplate: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer tr.Destroy()
+	dot := func() (c platform.Color, ok bool) {
+		onMain(func() { c, ok = tr.native.(interface{ Dot() (platform.Color, bool) }).Dot() })
+		return c, ok
+	}
+	if _, ok := dot(); ok {
+		t.Error("a new tray shows a dot")
+	}
+	if err := tr.SetDot("#ff3b30"); err != nil {
+		t.Fatal(err)
+	}
+	if c, ok := dot(); !ok || c != (platform.Color{R: 0xff, G: 0x3b, B: 0x30, A: 0xff}) {
+		t.Errorf("dot = %v %v, want #ff3b30", c, ok)
+	}
+	if err := tr.SetDot("not a color"); err == nil {
+		t.Error("SetDot took a bad color")
+	}
+	if c, ok := dot(); !ok || c.R != 0xff {
+		t.Errorf("a bad color changed the dot: %v %v", c, ok)
+	}
+	if err := tr.SetDot(""); err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := dot(); ok {
+		t.Error(`SetDot("") left the dot`)
+	}
+}
